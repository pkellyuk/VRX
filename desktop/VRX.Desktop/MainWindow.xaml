<Window x:Class="VRX.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:VRX.Desktop"
 Title="{l:Tr AppName}" Icon="Assets/vrx.ico" Width="1080" Height="900" MinWidth="800" MinHeight="640" Background="{StaticResource Page}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="14"
 UseLayoutRounding="True" Closing="WindowClosing" SourceInitialized="WindowSourceInitialized" StateChanged="WindowStateChanged">
 <!-- VRX's own title bar (the skin): the whole window is client area; Windows still moves,
      snaps and resizes it, and draws its shadow and (on Windows 11) its rounded corners. -->
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Border x:Name="WindowFrame" Background="{StaticResource Page}" BorderBrush="{StaticResource WindowEdge}" BorderThickness="1">
 <Grid x:Name="FrameGrid">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid Grid.Row="1" x:Name="RootGrid" Margin="24,20,24,18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <!-- Header: name and version (Expert; the title bar has them in Easy), and the Easy | Expert switch -->
  <Grid x:Name="HeaderGrid" Margin="0,0,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
    <StackPanel x:Name="NameRow" Orientation="Horizontal"><TextBlock Text="{l:Tr AppName}" FontSize="32" FontWeight="Bold"/><TextBlock x:Name="VersionText" FontSize="15" Foreground="{StaticResource Accent}" VerticalAlignment="Bottom" Margin="10,0,0,6"/></StackPanel>
    <TextBlock x:Name="Subtitle" Foreground="{StaticResource Soft}" TextWrapping="Wrap" Margin="0,2,0,0"/>
   </StackPanel>
   <Border Grid.Column="1" x:Name="ModeSwitch" Background="{StaticResource ChromeBar}" BorderBrush="{StaticResource WindowEdge}" BorderThickness="1" CornerRadius="24" Padding="4" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal">
     <RadioButton x:Name="EasyMode" GroupName="Mode" Style="{StaticResource ModeSegment}" Checked="ModeChecked" ToolTip="{l:Tr ModeEasyTip}">
      <StackPanel><TextBlock Text="{l:Tr ModeEasy}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{l:Tr ModeEasyCaption}" FontSize="11" HorizontalAlignment="Center" Opacity="0.8"/></StackPanel>
     </RadioButton>
     <RadioButton x:Name="ExpertMode" GroupName="Mode" Style="{StaticResource ModeSegment}" Checked="ModeChecked" ToolTip="{l:Tr ModeExpertTip}">
      <StackPanel><TextBlock Text="{l:Tr ModeExpert}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{l:Tr ModeExpertCaption}" FontSize="11" HorizontalAlignment="Center" Opacity="0.8"/></StackPanel>
     </RadioButton>
    </StackPanel>
   </Border>
  </Grid>

  <!-- Always visible: the game card with the main button (Expert: Start, Restart, Play, Play
       display or Attach / Play, MainWindow.UpdateStartButton; Easy: Attach / Play) and Stop VR
       (Easy adds Recenter) -->
  <StackPanel Grid.Row="1" x:Name="TopArea">
   <TextBlock x:Name="EasyIntro" Text="{l:Tr EasyIntro}" FontSize="18" TextWrapping="Wrap" Margin="2,0,0,14"/>
   <Border x:Name="GameCard" Background="{StaticResource Card}" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="12" Padding="18,14,10,6" Margin="0,0,0,14">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource Well}" VerticalAlignment="Top" Margin="0,0,14,8">
      <Image x:Name="CardIcon" Width="32" Height="32"/>
     </Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,8">
      <TextBlock Text="{l:Tr CardCaption}" FontSize="11" Foreground="{StaticResource Muted}"/>
      <TextBlock x:Name="CardName" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="CardState" Foreground="{StaticResource Soft}" TextWrapping="Wrap"/>
     </StackPanel>
     <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="560">
      <Button x:Name="ChooseButton" Content="{l:Tr ChooseButton}" ToolTip="{l:Tr ChooseTip}" Click="ChooseClick"/>
      <Button x:Name="StartButton" Style="{StaticResource Primary}" Content="{l:Tr AttachPlay}" Click="StartClick" IsEnabled="False"/>
      <Button x:Name="StopButton" Content="{l:Tr StopVr}" Click="StopClick" IsEnabled="False"/>
      <Button x:Name="EasyRecenterButton" Content="{l:Tr Recenter}" ToolTip="{l:Tr RecenterTip}" Click="RecenterClick" IsEnabled="False"/>
     </WrapPanel>
    </Grid>
   </Border>
   <!-- Expert: auto-attach and its countdown, always in view under the game card (outside
        the scrolling sections). App-wide, so usable with no game chosen. Easy keeps it on
        and does not show it (SetMode). Right of it, the selected game's Depth | Geometry
        switch (Easy always uses depth, so Easy hides it with the row); when the row is too
        narrow the switch moves to a second row (PlaceStereoModeSwitch). -->
   <Grid x:Name="AutoAttachPanel" Margin="4,-4,4,12" ToolTip="{l:Tr AutoAttachTip}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="90" MaxWidth="320"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <CheckBox x:Name="AutoAttachCheck" Content="{l:Tr AutoAttachCheck}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" Checked="AutoAttachChanged" Unchecked="AutoAttachChanged"/>
    <TextBlock Grid.Column="1" x:Name="AutoAttachCountdownLabel" Text="{l:Tr AutoAttachCountdown}" VerticalAlignment="Center" Foreground="{StaticResource Soft}" Margin="0,0,10,0"/>
    <Slider Grid.Column="2" x:Name="AutoAttachSlider" Minimum="3" Maximum="30" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0" ValueChanged="AutoAttachSecondsChanged" AutomationProperties.Name="{l:Tr AutoAttachCountdown}"/>
    <TextBlock Grid.Column="3" x:Name="AutoAttachValue" Style="{StaticResource Value}" MinWidth="36" VerticalAlignment="Center" Margin="10,0,0,0"/>
    <!-- Depth | Geometry for the selected game (its per-game launch setting): Geometry asks
         first (the anti-cheat warning, else the red warning); locked on Depth, with the reason
         in its tooltip, for a whole display or a game VRX cannot start. -->
    <Border Grid.Column="5" x:Name="StereoModeSwitch" Background="{StaticResource ChromeBar}" BorderBrush="{StaticResource WindowEdge}" BorderThickness="1" CornerRadius="20" Padding="3"
            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0" ToolTipService.ShowOnDisabled="True" ToolTip="{l:Tr StereoModeTip}"
            AutomationProperties.Name="{l:Tr StereoModeName}">
     <StackPanel Orientation="Horizontal">
      <RadioButton x:Name="DepthModeButton" GroupName="StereoMode" Style="{StaticResource ModeSegmentCompact}" Content="{l:Tr StereoModeDepth}" Checked="StereoModeChecked" IsChecked="True"/>
      <RadioButton x:Name="GeometryModeButton" GroupName="StereoMode" Style="{StaticResource ModeSegmentCompact}" Content="{l:Tr StereoModeGeometry}" Checked="StereoModeChecked"/>
     </StackPanel>
    </Border>
   </Grid>
  </StackPanel>

  <!-- Easy: a few hints; everything else is hidden -->
  <StackPanel Grid.Row="2" x:Name="EasyPanel" Margin="2,0,0,0">
   <TextBlock Text="{l:Tr EasyHintSettings}" Style="{StaticResource Hint}" FontSize="13"/>
   <TextBlock Text="{l:Tr EasyHintSteamVr}" Style="{StaticResource Hint}" FontSize="13"/>
  </StackPanel>

  <!-- Expert: every setting, in collapsible sections -->
  <ScrollViewer Grid.Row="2" x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
   <StackPanel x:Name="SectionsPanel" Margin="0,0,10,0">

    <!-- 1 Screen -->
    <Expander x:Name="ScreenSection" Header="{l:Tr SectionScreen}" Expanded="SectionToggled" Collapsed="SectionToggled">
     <StackPanel x:Name="ScreenContent">
      <TextBlock Text="{l:Tr ScreenHint}" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
      <Border Background="#101B2C" CornerRadius="8" Margin="0,0,0,12">
       <Canvas x:Name="Preview" Width="540" Height="168" HorizontalAlignment="Center" ClipToBounds="True" Background="Transparent" MouseLeftButtonDown="PreviewDown" MouseMove="PreviewMove" MouseLeftButtonUp="PreviewUp" ToolTip="{l:Tr PreviewTip}">
        <Line X1="270" X2="270" Y1="12" Y2="145" Stroke="#324761" StrokeDashArray="3,3"/>
        <Ellipse Canvas.Left="261" Canvas.Top="142" Width="18" Height="18" Fill="{StaticResource Accent}"/>
        <Line x:Name="ScreenLine" X1="210" X2="330" Y1="86" Y2="86" Stroke="#A5BEFF" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path x:Name="ScreenArc" Stroke="#A5BEFF" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
        <TextBlock Text="{l:Tr PreviewLabel}" Canvas.Left="12" Canvas.Top="10" FontSize="10" Foreground="#8297B7"/>
       </Canvas>
      </Border>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel>
        <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{l:TrValue ValueMetres, Element=WidthSlider}"/><TextBlock Style="{StaticResource Label}" Text="{l:Tr ScreenWidth}"/></DockPanel>
        <Slider x:Name="WidthSlider" Minimum="1" Maximum="10" Value="5.7" ValueChanged="SettingsChanged"/>
       </StackPanel>
       <StackPanel Grid.Column="2">
        <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{l:TrValue ValueMetres, Element=DistanceSlider}"/><TextBlock Style="{StaticResource Label}" Text="{l:Tr Distance}"/></DockPanel>
        <Slider x:Name="DistanceSlider" Minimum="1" Maximum="8" Value="3" ValueChanged="SettingsChanged"/>
       </StackPanel>
       <StackPanel Grid.Row="1">
        <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{l:TrValue ValueMetres, Element=HeightSlider}"/><TextBlock Style="{StaticResource Label}" Text="{l:Tr HeightOffset}"/></DockPanel>
        <Slider x:Name="HeightSlider" Minimum="-2" Maximum="2" Value="0" ValueChanged="SettingsChanged"/>
       </StackPanel>
       <StackPanel Grid.Row="1" Grid.Column="2">
        <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{l:TrValue ValueMetres, Element=HorizontalSlider}"/><TextBlock Style="{StaticResource Label}" Text="{l:Tr LeftRightOffset}"/></DockPanel>
        <Slider x:Name="HorizontalSlider" Minimum="-3" Maximum="3" Value="0" ValueChanged="SettingsChanged"/>
       </StackPanel>
      </Grid>
      <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{l:TrValue ValuePercent, Element=CurveSlider}"/><TextBlock Style="{StaticResource Label}" Text="{l:Tr ScreenCurve}"/></DockPanel>
      <Slider x:Name="CurveSlider" Minimum="0" Maximum="100" Value="0" ValueChanged="SettingsChanged" ToolTip="{l:Tr ScreenCurveTip}"/>
      <CheckBox x:Name="FollowCheck" Content="{l:Tr FollowHead}" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
      <WrapPanel Margin="0,10,0,0"><Button x:Name="RecenterButton" Content="{l:Tr RecenterNow}" ToolTip="{l:Tr RecenterTip}" Click="RecenterClick" IsEnabled="False"/></WrapPanel>
     </StackPanel>
    </Expander>

    <!-- 2 Around the screen -->
    <Expander x:Name="AroundSection" Header="{l:Tr SectionAround}" Expanded="SectionToggled" Collapsed="SectionToggled">
     <StackPanel x:Name="AroundContent">
      <CheckBox x:Name="AmbilightCheck" Content="{l:Tr Ambilight}" Checked="SettingsChanged" Unchecked="SettingsChanged" ToolTip="{l:Tr AmbilightTip}"/>
      <StackPanel Margin="26,2,0,4" IsEnabled="{Binding ElementName=AmbilightCheck, Path=IsChecked}">
       <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{l:TrValue ValuePercent, Element=AmbiStrengthSlider}"/><TextBlock Style="{StaticResource Label}" Text="{l:Tr AmbilightStrength}"/></DockPanel>
       <Slider x:Name="AmbiStrengthSlider" Minimum="0" Maximum="100" Value="85" ValueChanged="SettingsChanged" ToolTip="{l:Tr AmbilightStrengthTip}"/>
      </StackPanel>
      <TextBlock Text="{l:Tr WorldColour}" Style="{StaticResource Label}" Margin="0,4,0,6"/>
      <DockPanel Margin="0,0,0,4">
       <Border DockPanel.Dock="Right" Width="32" Height="28" CornerRadius="4" BorderBrush="#324761" BorderThickness="1" Margin="8,0,0,0"><Rectangle x:Name="WorldSwatch" Fill="Black" RadiusX="3" RadiusY="3"/></Border>
       <TextBox x:Name="WorldHex" DockPanel.Dock="Right" Width="96" MaxLength="7" Margin="8,0,0,0" Padding="4,0" VerticalContentAlignment="Center" TextChanged="WorldHexChanged" LostFocus="WorldHexLostFocus" ToolTip="{l:Tr WorldHexTip}"/>
       <ComboBox x:Name="WorldList" SelectionChanged="WorldListChanged" ToolTip="{l:Tr WorldListTip}"/>
      </DockPanel>
     </StackPanel>
    </Expander>

    <!-- 3 Room -->
    <Expander x:Name="RoomSection" Header="{l:Tr SectionRoom}" Expanded="SectionToggled" Collapsed="SectionToggled">
     <StackPanel x:Name="RoomContent">
      <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" x:Name="RoomValue"/><TextBlock x:Name="RoomLabel" Style="{StaticResource Label}" Text="{l:Tr RoomLabel}"/></DockPanel>
      <Slider x:Name="RoomSlider" Minimum="0" Maximum="100" Value="0" ValueChanged="SettingsChanged" ToolTip="{l:Tr RoomTip}"/>
      <Grid Margin="26,0,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel>
        <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" x:Name="GlassValue"/><TextBlock x:Name="GlassLabel" Style="{StaticResource Label}" Text="{l:Tr GlassWalls}"/></DockPanel>
        <Slider x:Name="GlassSlider" Minimum="0" Maximum="100" Value="0" ValueChanged="SettingsChanged" ToolTip="{l:Tr GlassTip}"/>
       </StackPanel>
       <StackPanel Grid.Column="2">
        <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" x:Name="ReflectValue"/><TextBlock x:Name="ReflectLabel" Style="{StaticResource Label}" Text="{l:Tr Reflections}"/></DockPanel>
        <Slider x:Name="ReflectSlider" Minimum="0" Maximum="100" Value="0" ValueChanged="SettingsChanged" ToolTip="{l:Tr ReflectTip}"/>
       </StackPanel>
       <StackPanel Grid.Row="1">
        <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" x:Name="LightValue"/><TextBlock x:Name="LightLabel" Style="{StaticResource Label}" Text="{l:Tr RoomLight}"/></DockPanel>
        <Slider x:Name="LightSlider" Minimum="0" Maximum="100" Value="0" ValueChanged="SettingsChanged" ToolTip="{l:Tr RoomLightTip}"/>
       </StackPanel>
       <StackPanel Grid.Row="1" Grid.Column="2">
        <TextBlock Text="{l:Tr LightColour}" Style="{StaticResource Label}" Margin="0,0,0,4"/>
        <ComboBox x:Name="LightColourList" SelectionChanged="SettingsChanged" ToolTip="{l:Tr LightColourTip}"/>
       </StackPanel>
      </Grid>
     </StackPanel>
    </Expander>

    <!-- 4 Estimated depth stereo: its content rests while the switch is on Geometry. -->
    <Expander x:Name="DepthSection" Header="{l:Tr SectionDepth}" Expanded="SectionToggled" Collapsed="SectionToggled">
     <StackPanel x:Name="DepthContent">
      <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{l:TrValue ValueNumber, Element=StrengthSlider}"/><TextBlock Style="{StaticResource Label}" Text="{l:Tr Strength3D}"/></DockPanel>
      <Slider x:Name="StrengthSlider" Minimum="0" Maximum="2" Value="1" ValueChanged="SettingsChanged"/>
      <CheckBox x:Name="StereoCheck" Content="{l:Tr EnableStereo}" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
      <StackPanel x:Name="AiDepthContent">
      <CheckBox x:Name="FastModelCheck" Content="{l:Tr FastModel}" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged" ToolTip="{l:Tr FastModelTip}"/>
      <CheckBox x:Name="SubpixelCheck" Content="{l:Tr Subpixel}" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged" ToolTip="{l:Tr SubpixelTip}"/>
      <CheckBox x:Name="SteadyCheck" Content="{l:Tr Steady}" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged" ToolTip="{l:Tr SteadyTip}"/>
      <CheckBox x:Name="FuseCheck" Content="{l:Tr Fuse}" IsEnabled="{Binding ElementName=FastModelCheck, Path=IsChecked}" Checked="SettingsChanged" Unchecked="SettingsChanged" ToolTip="{l:Tr FuseTip}"/>
      <TextBlock Text="{l:Tr FuseHint}" Style="{StaticResource Hint}" Margin="26,0,0,8"/>
      <TextBlock Text="{l:Tr DepthGpu}" Style="{StaticResource Label}" Margin="0,4,0,4"/>
      <ComboBox x:Name="DepthGpuList" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="SettingsChanged" ToolTip="{l:Tr DepthGpuTip}"/>
      <TextBlock Text="{l:Tr DepthGpuHint}" Style="{StaticResource Hint}"/>
      <CheckBox x:Name="ForegroundCheck" Content="{l:Tr ForegroundPasses}" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged" ToolTip="{l:Tr ForegroundTip}"/>
      <TextBlock Text="{l:Tr FrameTiming}" Style="{StaticResource Label}" Margin="0,8,0,4"/>
      <ComboBox x:Name="TimingList" SelectedIndex="0" SelectionChanged="SettingsChanged" ToolTip="{l:Tr FrameTimingTip}">
       <ComboBoxItem Content="{l:Tr TimingLatest}"/>
       <ComboBoxItem Content="{l:Tr TimingDelayed}"/>
       <ComboBoxItem Content="{l:Tr TimingMatched}"/>
      </ComboBox>
      <TextBlock Text="{l:Tr TimingHint}" Style="{StaticResource Hint}"/>
      </StackPanel>
     </StackPanel>
    </Expander>

    <!-- 5 True geometry: a per-game launch setting. It applies when VRX starts the game (a
         Vulkan layer and translation DLLs are loaded at launch); attaching to a running game
         uses estimated depth unless VRX started it with true geometry. -->
    <Expander x:Name="GeometrySection" Header="{l:Tr SectionGeometry}" Expanded="SectionToggled" Collapsed="SectionToggled">
     <StackPanel>
      <!-- Why it cannot be set up for the selection: nothing chosen, a whole display, or a game VRX cannot start. -->
      <TextBlock x:Name="GeometryUnavailableHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed"/>
      <StackPanel x:Name="GeometryPanel">
       <!-- Usable only while the Depth | Geometry switch under the game card is on Geometry. -->
       <TextBlock x:Name="GeometryModeHint" Text="{l:Tr GeometryToggleHint}" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
       <!-- Shown while true geometry is on for this game (GeometryWarning). -->
       <Border x:Name="GeometryWarningBanner" Background="{StaticResource WarningBack}" BorderBrush="{StaticResource WarningEdge}" BorderThickness="2" CornerRadius="6" Padding="12,8" Margin="0,4,0,0" Visibility="Collapsed">
        <TextBlock Text="{l:Tr GeometryWarningText}" Foreground="{StaticResource WarningInk}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </Border>
       <TextBlock x:Name="TestedHint" Text="{l:Tr TestedSystemShock}" Style="{StaticResource Hint}" Margin="0,6,0,0" Visibility="Collapsed"/>
       <WrapPanel Margin="0,8,0,0">
        <!-- Steam games only: the launch review and Steam's setup dialog, shown again (the
             main button on the game card starts or restarts the game with true geometry). -->
        <Button x:Name="SteamReviewSetupButton" Content="{l:Tr SteamReviewSetup}" ToolTip="{l:Tr SteamReviewSetupTip}" Click="SteamReviewSetupClick" IsEnabled="False" Visibility="Collapsed"/>
       </WrapPanel>
       <!-- The settings below are used only while the switch is on Geometry. -->
       <StackPanel x:Name="GeometryContent" Margin="0,10,0,0" IsEnabled="False">
        <TextBlock Text="{l:Tr GeometryHint}" Style="{StaticResource Hint}"/>
        <TextBlock Text="{l:Tr GeometryRenderer}" Style="{StaticResource Label}" Margin="0,8,0,4"/>
        <ComboBox x:Name="GeometryRendererList" SelectionChanged="GeometryRendererSelected">
         <ComboBoxItem Tag="geometry" Content="{l:Tr RendererAuto}"/>
         <ComboBoxItem Tag="vulkan" Content="{l:Tr PathVulkan}"/>
         <ComboBoxItem Tag="dxvk" Content="{l:Tr PathDxvk}"/>
         <ComboBoxItem Tag="vkd3d" Content="{l:Tr PathVkd3d}"/>
        </ComboBox>
        <TextBlock x:Name="RendererDetected" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <Grid Margin="0,8,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="{l:Tr GeometrySeparation}" Style="{StaticResource Label}"/>
          <Slider x:Name="GeometrySeparationSlider" Minimum="0.001" Maximum="2" SmallChange="0.005" LargeChange="0.05" Height="32" Margin="0,4,0,0" ValueChanged="GeometryTuningSliderChanged" ToolTip="{l:Tr GeometrySeparationTip}" AutomationProperties.Name="{l:Tr GeometrySeparation}"/>
         </StackPanel>
         <StackPanel Grid.Column="2">
          <TextBlock Text="{l:Tr GeometryConvergence}" Style="{StaticResource Label}"/>
          <Slider x:Name="GeometryConvergenceSlider" Minimum="0" Maximum="0.01" SmallChange="0.0002" LargeChange="0.001" Height="32" Margin="0,4,0,0" ValueChanged="GeometryTuningSliderChanged" ToolTip="{l:Tr GeometryConvergenceTip}" AutomationProperties.Name="{l:Tr GeometryConvergence}"/>
         </StackPanel>
        </Grid>
        <TextBlock x:Name="GeometryTuningHint" Text="{l:Tr GeometryTuningLive}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
        <!-- Developer: exact numbers and the stream's connection name. Not needed to play. -->
        <Expander x:Name="GeometryDeveloper" Header="{l:Tr GeometryDeveloper}" Margin="0,8,0,0">
         <StackPanel>
          <TextBlock Text="{l:Tr GeometryDeveloperHint}" Style="{StaticResource Hint}"/>
          <Grid Margin="0,4,0,0">
           <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Text="{l:Tr GeometrySeparationExact}" Style="{StaticResource Label}"/>
            <TextBox x:Name="GeometrySeparationText" MaxLength="20" TextChanged="GeometryTuningChanged" LostFocus="GeometryTuningLostFocus" ToolTip="{l:Tr GeometrySeparationTip}" AutomationProperties.Name="{l:Tr GeometrySeparationExact}"/>
           </StackPanel>
           <StackPanel Grid.Column="2">
            <TextBlock Text="{l:Tr GeometryConvergenceExact}" Style="{StaticResource Label}"/>
            <TextBox x:Name="GeometryConvergenceText" MaxLength="20" TextChanged="GeometryTuningChanged" LostFocus="GeometryTuningLostFocus" ToolTip="{l:Tr GeometryConvergenceTip}" AutomationProperties.Name="{l:Tr GeometryConvergenceExact}"/>
           </StackPanel>
          </Grid>
          <TextBlock Text="{l:Tr GeometrySession}" Style="{StaticResource Label}" Margin="0,8,0,4"/>
          <TextBox x:Name="GeometrySessionText" MaxLength="64" TextChanged="SettingsChanged" ToolTip="{l:Tr GeometrySessionTip}"/>
         </StackPanel>
        </Expander>
       </StackPanel>
      </StackPanel>
      <!-- Steam launch options that start games through VRX: listed to remove before moving
           or uninstalling VRX (SteamGeometry.ShowRemoval). App-wide, so usable without a game. -->
      <Button x:Name="SteamSetupsButton" Content="{l:Tr SteamRemoveSetups}" ToolTip="{l:Tr SteamRemoveSetupsTip}" Click="SteamSetupsClick" HorizontalAlignment="Left" Margin="0,10,0,0"/>
     </StackPanel>
    </Expander>

    <!-- 6 SteamVR & shortcuts -->
    <Expander x:Name="SteamVrSection" Header="{l:Tr SectionSteamVr}" Expanded="SectionToggled" Collapsed="SectionToggled">
     <StackPanel>
      <StackPanel x:Name="SteamVrContent">
       <CheckBox x:Name="DismissCheck" Content="{l:Tr DismissOnStart}" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
       <CheckBox x:Name="DesktopAwayCheck" Content="{l:Tr DesktopWhenAway}" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
       <TextBlock Text="{l:Tr DesktopWhenAwayHint}" Style="{StaticResource Hint}" Margin="26,0,0,8"/>
       <TextBlock Text="{l:Tr KeyboardShortcuts}" Style="{StaticResource SubHeader}"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{l:Tr ShortcutRecenter}" Style="{StaticResource Label}" Margin="0,0,0,4"/><ComboBox x:Name="RecenterKeys" DisplayMemberPath="Name" SelectedValuePath="Code" SelectionChanged="SettingsChanged"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="{l:Tr ShortcutDismiss}" Style="{StaticResource Label}" Margin="0,0,0,4"/><ComboBox x:Name="MenuKeys" DisplayMemberPath="Name" SelectedValuePath="Code" SelectionChanged="SettingsChanged"/></StackPanel>
       </Grid>
       <TextBlock Text="{l:Tr ShortcutsHint}" Style="{StaticResource Hint}" Margin="0,8,0,10"/>
       <WrapPanel><Button x:Name="DismissButton" Content="{l:Tr DismissMenuNow}" Click="DismissClick" IsEnabled="False"/></WrapPanel>
      </StackPanel>
     </StackPanel>
    </Expander>

    <!-- 7 Profile -->
    <Expander x:Name="ProfileSection" Header="{l:Tr SectionProfile}" Expanded="SectionToggled" Collapsed="SectionToggled">
     <StackPanel x:Name="ProfileContent">
      <TextBlock Text="{l:Tr ProfileHint}" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
      <WrapPanel>
       <Button x:Name="ResetButton" Content="{l:Tr ResetProfile}" Click="ResetClick" ToolTip="{l:Tr ResetProfileTip}"/>
       <Button x:Name="BaseButton" Content="{l:Tr MakeBase}" Click="MakeBaseClick" ToolTip="{l:Tr MakeBaseTip}"/>
       <Button x:Name="ApplyAllButton" Content="{l:Tr ApplyAll}" Click="ApplyAllClick" ToolTip="{l:Tr ApplyAllTip}"/>
      </WrapPanel>
     </StackPanel>
    </Expander>

    <!-- 8 Session details -->
    <Expander x:Name="SessionDetails" Header="{l:Tr SectionSession}" Expanded="SectionToggled" Collapsed="SectionToggled">
     <TextBox x:Name="LogBox" Height="160" IsReadOnly="True" Background="{StaticResource Well}" Foreground="{StaticResource Soft}" BorderThickness="0" Padding="6" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
    </Expander>
   </StackPanel>
  </ScrollViewer>

  <!-- Status line -->
  <Border Grid.Row="3" BorderBrush="{StaticResource CardEdge}" BorderThickness="0,1,0,0" Padding="2,10,2,0" Margin="0,8,0,0">
   <StackPanel>
    <TextBlock x:Name="Status" Text="{l:Tr StatusReady}" TextWrapping="Wrap" Foreground="{StaticResource Soft}"/>
   </StackPanel>
  </Border>
 </Grid>

 <!-- The title bar: the logo (the window menu), VRX and its version, and the caption
      buttons. Last in the file so the keyboard reaches it after the content. -->
 <Grid Grid.Row="0" x:Name="TitleBar" Height="32" Background="{StaticResource ChromeBar}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Background="{StaticResource ChromeEdge}"/>
  <Button x:Name="MenuButton" Style="{StaticResource CaptionIcon}" Click="MenuClick" ToolTip="{l:Tr TitleMenu}" AutomationProperties.Name="{l:Tr TitleMenu}">
   <Image Source="Assets/vrx.ico" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
  </Button>
  <StackPanel Grid.Column="1" Orientation="Horizontal" IsHitTestVisible="False">
   <TextBlock Style="{StaticResource TitleText}" Text="{l:Tr AppName}" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
   <TextBlock Style="{StaticResource TitleText}" x:Name="TitleVersion" Foreground="{StaticResource Accent}" Margin="6,0,0,0"/>
  </StackPanel>
  <StackPanel Grid.Column="2" Orientation="Horizontal">
   <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Click="MinimizeClick" ToolTip="{l:Tr TitleMinimize}" AutomationProperties.Name="{l:Tr TitleMinimize}">
    <Path Style="{StaticResource CaptionGlyph}" Data="M 0,5.5 L 10,5.5"/>
   </Button>
   <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="MaximizeClick" ToolTip="{l:Tr TitleMaximize}" AutomationProperties.Name="{l:Tr TitleMaximize}">
    <Path x:Name="MaxGlyph" Style="{StaticResource CaptionGlyph}" Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"/>
   </Button>
   <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Click="CloseClick" ToolTip="{l:Tr TitleClose}" AutomationProperties.Name="{l:Tr TitleClose}">
    <Path Style="{StaticResource CaptionGlyph}" Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
   </Button>
  </StackPanel>
 </Grid>
 </Grid>
 </Border>
</Window>
