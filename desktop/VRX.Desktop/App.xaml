<Application x:Class="VRX.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="#E8EEF8"/>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#142236"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#142236"/><Setter Property="MinHeight" Value="30"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="Slider"><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="IsSnapToTickEnabled" Value="True"/><Setter Property="TickFrequency" Value="0.05"/></Style>
 </Application.Resources>
</Application>
