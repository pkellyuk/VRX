<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\vrx.ico</ApplicationIcon>
    <Version>1.7.1</Version>
    <Product>VRX</Product>
    <Description>Desktop-controlled stereo gaming in VR</Description>
    <!-- Strings.resx is English; translations (Strings.<culture>.resx) become satellite
         assemblies and are chosen from the Windows display language. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <!-- Also embedded as a resource so the window and taskbar use it. Regenerate
         with desktop\assets\make_icon.py. -->
    <Resource Include="Assets\vrx.ico" />
  </ItemGroup>
</Project>
