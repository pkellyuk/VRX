<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ApplicationIcon>Assets\vrx.ico</ApplicationIcon>
    <Version>1.8.1</Version>
    <Product>VRX</Product>
    <Company>VRX</Company>
    <Copyright>Copyright (C) 2026 Paul Kelly. GPL-3.0.</Copyright>
    <Description>Desktop-controlled stereo gaming in VR</Description>
    <!-- Strings.resx is English; translations (Strings.<culture>.resx) become satellite
         assemblies and are chosen from the Windows display language. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CefSharp.OffScreen.NETCore" Version="156.0.150" />
    <!-- Also embedded as a resource so the window and taskbar use it. Regenerate
         with desktop\assets\make_icon.py. -->
    <Resource Include="Assets\vrx.ico" />
  </ItemGroup>
  <Target Name="UseVrxBrowserRuntime" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).runtimeconfig.json" DestinationFiles="$(TargetDir)CefSharp.BrowserSubprocess.runtimeconfig.json" Condition="Exists('$(TargetDir)CefSharp.BrowserSubprocess.runtimeconfig.json')" />
  </Target>
  <Target Name="UsePublishedVrxBrowserRuntime" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).runtimeconfig.json" DestinationFiles="$(PublishDir)CefSharp.BrowserSubprocess.runtimeconfig.json" Condition="Exists('$(PublishDir)CefSharp.BrowserSubprocess.runtimeconfig.json')" />
  </Target>
</Project>
