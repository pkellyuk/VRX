<Window x:Class="VRX.Desktop.ChooserWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:VRX.Desktop"
 Title="{l:Tr ChooserTitle}" Icon="Assets/vrx.ico" Width="1000" Height="700" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
 Background="{StaticResource Page}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
 <!-- The same skin as the main window: VRX's own title bar over a client-area-only window. -->
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Window.Resources>
  <!-- A tile: a card that lights up in the accent when pointed at; the one VRX has selected
       now (Tag "Current") keeps an accent edge. -->
  <Style x:Key="Tile" TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="{StaticResource Card}"/>
   <Setter Property="BorderBrush" Value="{StaticResource CardEdge}"/>
   <Setter Property="Margin" Value="0,0,14,14"/>
   <Setter Property="Padding" Value="10"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="10" Padding="{TemplateBinding Padding}">
       <ContentPresenter RecognizesAccessKey="False"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="Tag" Value="Current"><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource RaisedEdge}"/></Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Face" Property="Background" Value="{StaticResource Hover}"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Ink}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Border Background="{StaticResource Page}" BorderBrush="{StaticResource WindowEdge}" BorderThickness="1">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

   <!-- Title bar -->
   <Grid Height="32" Background="{StaticResource ChromeBar}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Background="{StaticResource ChromeEdge}"/>
    <Image Source="Assets/vrx.ico" Width="16" Height="16" Margin="15,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
    <TextBlock Grid.Column="1" Style="{StaticResource TitleText}" Text="{l:Tr ChooserTitle}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" IsHitTestVisible="False"/>
    <Button Grid.Column="2" x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Click="CloseClick" ToolTip="{l:Tr TitleClose}" AutomationProperties.Name="{l:Tr TitleClose}">
     <Path Style="{StaticResource CaptionGlyph}" Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
    </Button>
   </Grid>

   <TextBlock Grid.Row="1" x:Name="Intro" Text="{l:Tr ChooserIntro}" FontSize="16" TextWrapping="Wrap" Margin="24,18,24,6"/>

   <!-- The tiles (built in code): windows front to back, then each display. Pixel
        scrolling, so the live window pictures can follow the tiles exactly. -->
   <ScrollViewer Grid.Row="2" x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Margin="12,0,6,12">
    <StackPanel x:Name="Sections" Margin="12,0,6,0">
     <TextBlock x:Name="WindowsHeader" Text="{l:Tr ChooserWindows}" Style="{StaticResource SubHeader}" Margin="0,10,0,8"/>
     <WrapPanel x:Name="WindowTiles"/>
     <TextBlock x:Name="NoWindows" Text="{l:Tr ChooserNoWindows}" Style="{StaticResource Hint}" FontSize="13" Visibility="Collapsed"/>
     <TextBlock x:Name="ScreensHeader" Text="{l:Tr ChooserScreens}" Style="{StaticResource SubHeader}" Margin="0,16,0,2"/>
     <TextBlock Text="{l:Tr ChooserScreensHint}" Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,8"/>
     <WrapPanel x:Name="ScreenTiles"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Border>
</Window>
