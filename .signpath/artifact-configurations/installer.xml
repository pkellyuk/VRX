<?xml version="1.0" encoding="utf-8"?>
<!-- Second signing request of a release: the installer, built from the signed programs. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="VRX-Setup-*.exe" product-name="VRX" min-matches="1" max-matches="1" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
