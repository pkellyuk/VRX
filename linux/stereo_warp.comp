#version 450

// Vulkan version of the forward stereo warp in stereo_warp.h. One workgroup
// owns a complete scanline, so scatter, z selection, and hole filling have
// the same deterministic order as the CPU reference.
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer Scene { uint scene[]; };
layout(std430, set = 0, binding = 1) readonly buffer Nearness { float near01[]; };
layout(std430, set = 0, binding = 2) writeonly buffer Color { uint color[]; };
layout(std430, set = 0, binding = 3) writeonly buffer ProjectiveDepth { float depth[]; };

layout(push_constant) uniform Parameters {
    float focalPx;
    float scale;
    float invZNear;
    float invZFar;
    float nearZ;
    float farZ;
    float eyeOffset;
    int fillMode;
    int subpixel;
    int bgra;
} p;

const int W = 686;
const int H = 392;
const float mirrorTolerance = 0.08;
shared int source[W];
shared float landedAt[W];

float nearness(int y, int x) { return near01[y * W + x]; }

void fillHole(int y, int begin, int end, int left, int right) {
    if (left < 0 && right < 0) {
        for (int h = begin; h < end; ++h) source[h] = -2 - begin;
        return;
    }
    bool useLeft = left >= 0 && !(right >= 0 && nearness(y, right) < nearness(y, left));
    int anchor = useLeft ? left : right;
    if (p.fillMode != 1) {
        for (int h = begin; h < end; ++h) source[h] = -2 - anchor;
        return;
    }
    float anchorNear = nearness(y, anchor);
    int good = anchor;
    for (int k = 1; k <= end - begin; ++k) {
        int h = useLeft ? begin - 1 + k : end - k;
        int candidate = clamp(anchor + (useLeft ? -k : k), 0, W - 1);
        if (nearness(y, candidate) <= anchorNear + mirrorTolerance) good = candidate;
        source[h] = -2 - good;
    }
}

vec3 unpackColor(uint pixel) {
    return vec3(float(pixel & 255u), float((pixel >> 8) & 255u),
                float((pixel >> 16) & 255u)) / 255.0;
}

void main() {
    int y = int(gl_WorkGroupID.y);
    int eye = int(gl_WorkGroupID.z);
    if (y >= H || eye >= 2) return;
    for (int x = 0; x < W; ++x) source[x] = -1;
    for (int x = 0; x < W; ++x) {
        float invZ = p.invZFar + nearness(y, x) * (p.invZNear - p.invZFar);
        float shift = p.scale * p.focalPx * (eye == 0 ? -p.eyeOffset : p.eyeOffset) * invZ;
        float destination = float(x) - shift;
        int dx = x - (shift < 0.0 ? -int(floor(-shift + 0.5)) : int(floor(shift + 0.5)));
        if (dx < 0 || dx >= W) continue;
        if (source[dx] < 0 || nearness(y, x) > nearness(y, source[dx])) {
            source[dx] = x;
            landedAt[dx] = destination;
        }
    }
    int lastValid = -1;
    for (int x = 0; x < W; ++x) {
        if (source[x] >= 0) { lastValid = source[x]; continue; }
        int end = x + 1;
        while (end < W && source[end] < 0) ++end;
        int rightValid = end < W ? source[end] : -1;
        fillHole(y, x, end, lastValid, rightValid);
        x = end - 1;
    }
    for (int x = 0; x < W; ++x) {
        bool filled = source[x] < 0;
        int s = filled ? -2 - source[x] : source[x];
        float pos = p.subpixel != 0 && !filled ?
            clamp(float(s) + float(x) - landedAt[x], 0.0, float(W - 1)) : float(s);
        int i0 = int(pos);
        int i1 = min(i0 + 1, W - 1);
        float fraction = pos - float(i0);
        vec3 a = unpackColor(scene[y * W + i0]);
        vec3 b = unpackColor(scene[y * W + i1]);
        uvec3 c = uvec3(floor((a + fraction * (b - a)) * 255.0 + 0.5));
        if (p.bgra != 0) c = c.bgr;
        uint packed = c.r | (c.g << 8) | (c.b << 16) | (255u << 24);
        int outputIndex = (eye * H + y) * W + x;
        color[outputIndex] = packed;
        float sourceInvZ = p.invZFar + nearness(y, s) * (p.invZNear - p.invZFar);
        depth[outputIndex] = (p.farZ / (p.farZ - p.nearZ)) * (1.0 - p.nearZ * sourceInvZ);
    }
}
