#version 450

// Flat-screen room LIGHT pass: one invocation per texel of the six-face 64x64
// lightmap. Geometry, form factors and bounce follow room.h RoomTexel.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(std430, set = 0, binding = 2) readonly buffer Emitters { vec4 emit[]; };
layout(std430, set = 0, binding = 4) writeonly buffer Lightmap { vec4 light[]; };
layout(push_constant) uniform Parameters {
    vec4 bounds;       // X, floor, ceiling, back wall
    vec4 geometry;     // front gap, front side depth, floor shade, ceiling shade
    vec4 shading;      // wall, floor, ceiling albedos, bounce scale
    vec4 worldCount;   // linear world RGB, emitter count
} p;
const float PI = 3.14159265358979;

void facePoint(uint face, float u, float v, out vec3 point, out vec3 normal) {
    float X = p.bounds.x, floorY = p.bounds.y, ceilingY = p.bounds.z, backZ = p.bounds.w;
    float gap = p.geometry.x, sideZ = p.geometry.y;
    float y = ceilingY - v * (ceilingY - floorY);
    if (face == 0u) { point = vec3(-X + u * 2.0 * X, y, -gap); normal = vec3(0, 0, 1); }
    else if (face == 1u) { point = vec3(-X, y, sideZ + u * (backZ - sideZ)); normal = vec3(1, 0, 0); }
    else if (face == 2u) { point = vec3(X, y, sideZ + u * (backZ - sideZ)); normal = vec3(-1, 0, 0); }
    else if (face == 3u) { point = vec3(-X + u * 2.0 * X, floorY, -gap + v * (backZ + gap)); normal = vec3(0, 1, 0); }
    else if (face == 4u) { point = vec3(-X + u * 2.0 * X, ceilingY, -gap + v * (backZ + gap)); normal = vec3(0, -1, 0); }
    else { point = vec3(-X + u * 2.0 * X, y, backZ); normal = vec3(0, 0, -1); }
}

float lambertQuad(vec3 point, vec3 normal, vec3 c0, vec3 c1, vec3 c2, vec3 c3) {
    vec3 corners[4] = vec3[4](c0, c1, c2, c3);
    vec3 unitRay[4];
    for (int k = 0; k < 4; ++k) {
        vec3 delta = corners[k] - point;
        float lengthRay = sqrt(dot(delta, delta));
        if (!(lengthRay > 1e-9)) return 0.0;
        unitRay[k] = delta / lengthRay;
    }
    float sum = 0.0;
    for (int k = 0; k < 4; ++k) {
        vec3 a = unitRay[k], b = unitRay[(k + 1) & 3];
        vec3 crossRay = cross(a, b);
        float crossLength = sqrt(dot(crossRay, crossRay));
        if (!(crossLength > 1e-12)) continue;
        float angle = atan(crossLength, dot(a, b));
        sum += angle * dot(normal, crossRay) / crossLength;
    }
    return 0.5 * abs(sum);
}

float formFactor(vec3 point, vec3 normal, uint e) {
    uint base = e * 6u;
    vec4 c0 = emit[base], c1 = emit[base + 1u], c2 = emit[base + 2u], c3 = emit[base + 3u];
    vec4 nq = emit[base + 4u];
    vec3 delta = 0.5 * (c0.xyz + c2.xyz) - point;
    float np = dot(normal, delta);
    float nqv = -dot(nq.xyz, delta);
    if (!(np > 0.0) || !(nqv > 0.0)) return 0.0;
    float r2 = dot(delta, delta);
    float area = c0.w, diagonal2 = c1.w;
    if (r2 >= 4.0 * diagonal2) return area * (np * nqv / r2) / (r2 + area / PI);
    return lambertQuad(point, normal, c0.xyz, c1.xyz, c2.xyz, c3.xyz);
}

void main() {
    uint x = gl_GlobalInvocationID.x, y = gl_GlobalInvocationID.y, face = gl_GlobalInvocationID.z;
    if (x >= 64u || y >= 64u || face >= 6u) return;
    vec3 point, normal;
    facePoint(face, (float(x) + 0.5) / 64.0, (float(y) + 0.5) / 64.0, point, normal);
    vec3 E = vec3(0.0), flux = vec3(0.0);
    uint count = uint(p.worldCount.w);
    for (uint e = 0u; e < count; ++e) {
        uint base = e * 6u;
        if (emit[base + 4u].w == 0.0) continue;
        float G = formFactor(point, normal, e);
        float areaPi = PI * emit[base].w;
        vec3 radiance = emit[base + 5u].rgb;
        E += radiance * G;
        flux += radiance * areaPi;
    }
    float rho = face == 3u ? p.shading.y : (face == 4u ? p.shading.z : p.shading.x);
    float shade = face == 3u ? p.geometry.z : (face == 4u ? p.geometry.w : 1.0);
    vec3 colour = (rho / PI) * (E + flux * p.shading.w) + shade * p.worldCount.rgb;
    light[(face * 64u + y) * 64u + x] = vec4(colour, 1.0);
}
