#version 450

// Port of xrapp5.cpp kPrepHlsl. Packed RGBA source -> NCHW float tensor.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer Source { uint rgba[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Tensor { float nchw[]; };

layout(push_constant) uniform Parameters {
    uint sourceWidth;
    uint sourceHeight;
    uint outputWidth;
    uint outputHeight;
    uint taps;
    uint exactLoad;
    float cropX;
    float cropY;
    float cropSize;
    uint normalize;
} p;

vec3 loadRgb(ivec2 xy) {
    xy = clamp(xy, ivec2(0), ivec2(int(p.sourceWidth) - 1, int(p.sourceHeight) - 1));
    uint pixel = rgba[uint(xy.y) * p.sourceWidth + uint(xy.x)];
    return vec3(float(pixel & 255u), float((pixel >> 8) & 255u),
                float((pixel >> 16) & 255u)) / 255.0;
}

vec3 sampleRgb(vec2 uv) {
    vec2 pixel = clamp(uv * vec2(p.sourceWidth, p.sourceHeight) - 0.5,
                       vec2(0), vec2(p.sourceWidth - 1u, p.sourceHeight - 1u));
    ivec2 p0 = ivec2(pixel);
    ivec2 p1 = min(p0 + ivec2(1), ivec2(p.sourceWidth, p.sourceHeight) - ivec2(1));
    vec2 fraction = pixel - vec2(p0);
    vec3 top = mix(loadRgb(p0), loadRgb(ivec2(p1.x, p0.y)), fraction.x);
    vec3 bottom = mix(loadRgb(ivec2(p0.x, p1.y)), loadRgb(p1), fraction.x);
    return mix(top, bottom, fraction.y);
}

void main() {
    uvec2 id = gl_GlobalInvocationID.xy;
    if (id.x >= p.outputWidth || id.y >= p.outputHeight) return;
    vec3 value = vec3(0);
    if (p.exactLoad != 0u) {
        value = loadRgb(ivec2(id));
    } else {
        for (uint j = 0u; j < p.taps; ++j) for (uint i = 0u; i < p.taps; ++i) {
            vec2 uv = (vec2(id) + (vec2(i, j) + 0.5) / float(p.taps)) /
                      vec2(p.outputWidth, p.outputHeight);
            value += sampleRgb(vec2(p.cropX, p.cropY) + uv * p.cropSize);
        }
        value /= float(p.taps * p.taps);
    }
    if (p.normalize != 0u)
        value = (value - vec3(0.485, 0.456, 0.406)) *
                vec3(1.0 / 0.229, 1.0 / 0.224, 1.0 / 0.225);
    uint index = id.y * p.outputWidth + id.x;
    uint plane = p.outputWidth * p.outputHeight;
    nchw[index] = value.r;
    nchw[plane + index] = value.g;
    nchw[2u * plane + index] = value.b;
}
