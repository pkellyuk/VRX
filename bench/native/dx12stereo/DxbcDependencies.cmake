# Microsoft DXC's public token definitions and container hash; pinned inputs.
set(dxbc_support "${CMAKE_CURRENT_BINARY_DIR}/_deps/dxbc-support")
file(MAKE_DIRECTORY "${dxbc_support}")
function(dxbc_fetch name path digest)
    set(destination "${dxbc_support}/${name}")
    if(EXISTS "${destination}")
        file(SHA256 "${destination}" actual)
        if(actual STREQUAL digest)
            return()
        endif()
    endif()
    file(DOWNLOAD "https://raw.githubusercontent.com/microsoft/DirectXShaderCompiler/194bb75bea2becb42810d72a16195089c1908e10/${path}"
        "${destination}" EXPECTED_HASH "SHA256=${digest}" TLS_VERIFY ON TIMEOUT 60 INACTIVITY_TIMEOUT 20)
endfunction()
dxbc_fetch(DxilHash.cpp lib/DxilHash/DxilHash.cpp d66b631ea28d4c90a8217fac004f9290eaac07f79115451e0c4e954c0b0c94af)
dxbc_fetch(d3d12TokenizedProgramFormat.hpp include/dxc/Support/d3d12TokenizedProgramFormat.hpp cf808b363406fce9387d7ec8daec19940175af966589c0d3e084a4c41c3f5060)
dxbc_fetch(LICENSE.TXT LICENSE.TXT 27a49e35d1da96eba18fba54bc882667ff0ff8c0254f16f2b6e165d605ba7df8)
file(WRITE "${dxbc_support}/NOTICE.txt"
    "DXBC/DXIL container hashing and token declarations from Microsoft DirectXShaderCompiler.\nCopyright (C) Microsoft Corporation. All rights reserved.\nRevision 194bb75bea2becb42810d72a16195089c1908e10.\nThese files use the University of Illinois/NCSA Open Source License.\nSee the accompanying DXC-Hash-LICENSE.txt for the complete upstream license.\n")
add_library(vrx_dxbc_hash STATIC "${dxbc_support}/DxilHash.cpp")
target_compile_definitions(vrx_dxbc_hash PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
set_property(TARGET vrx_dxbc_hash PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
add_library(vrx_dxbc_patch STATIC dxbc_patch.cpp)
target_include_directories(vrx_dxbc_patch PRIVATE "${dxbc_support}")
target_compile_definitions(vrx_dxbc_patch PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
target_link_libraries(vrx_dxbc_patch PRIVATE vrx_dxbc_hash)
set_property(TARGET vrx_dxbc_patch PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
if(MSVC)
    target_compile_options(vrx_dxbc_patch PRIVATE /W4 /WX /EHsc)
endif()
function(dxbc_copy_license target)
    add_custom_command(TARGET ${target} POST_BUILD COMMAND "${CMAKE_COMMAND}" -E copy_if_different
        "${dxbc_support}/LICENSE.TXT" "$<TARGET_FILE_DIR:${target}>/DXC-Hash-LICENSE.txt")
    add_custom_command(TARGET ${target} POST_BUILD COMMAND "${CMAKE_COMMAND}" -E copy_if_different
        "${dxbc_support}/NOTICE.txt" "$<TARGET_FILE_DIR:${target}>/DXC-Hash-NOTICE.txt")
endfunction()
