<!--
  The native NuGet packages the engine is built against, pinned. "dotnet restore" on this
  file puts them in %USERPROFILE%\.nuget\packages, where bench\native\openxr\build.bat and
  release\build-release.ps1 look for them. Nothing is built from this project.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageDownload Include="Microsoft.ML.OnnxRuntime.DirectML" Version="[1.24.4]" />
    <PackageDownload Include="Microsoft.AI.DirectML" Version="[1.15.4]" />
  </ItemGroup>
</Project>
